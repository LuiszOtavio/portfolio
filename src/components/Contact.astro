---
import { profile } from '../data/profile';
import { useTranslations, type Lang } from '../i18n/utils';
import Icon from './Icon.astro';
import Section from './Section.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// No phone number on the site (briefing: it stays only in the PDF CV).
const channels = [
  {
    icon: 'linkedin' as const,
    label: 'LinkedIn',
    value: `in/${profile.linkedinHandle}`,
    href: profile.linkedin,
    external: true,
  },
  {
    icon: 'github' as const,
    label: 'GitHub',
    value: profile.githubHandle,
    href: profile.github,
    external: true,
  },
  {
    icon: 'download' as const,
    label: t('contact.cv'),
    value: 'PDF',
    href: profile.cv[lang],
    download: profile.cvDownloadName[lang],
  },
];

const cardClass =
  'group flex items-center gap-4 rounded-lg border border-border bg-bg p-4 transition-colors hover:border-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary';
---

<Section id="contact" title={t('nav.contact')} band>
  <p class="max-w-2xl text-lg leading-relaxed text-muted">{t('contact.intro')}</p>

  <a
    href={`mailto:${profile.email}`}
    class="group mt-8 inline-flex max-w-full items-center gap-3 text-xl font-semibold break-all transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary sm:text-3xl"
  >
    <Icon name="mail" class="size-6 shrink-0 text-primary sm:size-8" />
    <span class="bg-linear-to-r from-primary to-accent bg-[length:0%_2px] bg-bottom-left bg-no-repeat pb-1 transition-[background-size] duration-300 group-hover:bg-[length:100%_2px]">
      {profile.email}
    </span>
  </a>

  <ul class="mt-10 grid gap-4 sm:grid-cols-3">
    {
      channels.map((channel) => (
        <li>
          <a
            href={channel.href}
            class={cardClass}
            {...(channel.external && { target: '_blank', rel: 'noopener noreferrer' })}
            {...(channel.download && { download: channel.download })}
          >
            <span class="flex size-10 shrink-0 items-center justify-center rounded-md bg-surface text-primary transition-colors group-hover:bg-primary-strong group-hover:text-white">
              <Icon name={channel.icon} class="size-5" />
            </span>
            <span class="min-w-0">
              <span class="block font-medium">{channel.label}</span>
              <span class="block truncate font-mono text-xs text-muted">{channel.value}</span>
            </span>
            {channel.external && <span class="sr-only">{t('hero.newTab')}</span>}
          </a>
        </li>
      ))
    }
  </ul>
</Section>
