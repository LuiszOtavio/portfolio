---
import { experience } from '../data/experience';
import { useTranslations, type Lang } from '../i18n/utils';
import Section from './Section.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Section id="experience" title={t('nav.experience')}>
  <ol class="relative border-l border-border">
    {
      experience[lang].map((job) => (
        <li class="relative pb-10 pl-6 last:pb-0 sm:pl-8">
          <span
            class="absolute top-1.5 -left-[5.5px] size-2.5 rounded-full bg-primary ring-4 ring-bg"
            aria-hidden="true"
          />
          <p class="font-mono text-sm text-muted">
            <time datetime={job.start}>{job.period}</time>
          </p>
          <h3 class="mt-1 text-xl font-semibold">
            {job.role}{' '}
            <span class="text-primary">· {job.company}</span>
          </h3>
          <ul class="mt-4 max-w-3xl space-y-2 text-muted">
            {job.highlights.map((item) => (
              <li class="flex gap-3 leading-relaxed">
                <span class="mt-2.5 h-px w-3 shrink-0 bg-accent" aria-hidden="true" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</Section>
