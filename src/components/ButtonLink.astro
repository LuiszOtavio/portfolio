---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md';
  /** Opens in a new tab with safe rel attributes. */
  external?: boolean;
}

const { variant = 'primary', size = 'md', external = false, class: className, ...attrs } = Astro.props;

const variants = {
  primary: 'bg-primary-strong text-white hover:bg-primary-strong/85',
  secondary: 'border border-border text-text hover:border-primary hover:text-primary',
  ghost: 'text-muted hover:text-text',
};

const sizes = {
  sm: 'gap-1.5 px-3 py-2 text-sm',
  md: 'gap-2 px-5 py-3 text-base',
};
---

<a
  {...attrs}
  {...external && { target: '_blank', rel: 'noopener noreferrer' }}
  class:list={[
    'inline-flex items-center justify-center rounded-md font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary',
    variants[variant],
    sizes[size],
    className,
  ]}
>
  <slot />
</a>
