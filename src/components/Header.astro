---
import { languages, useTranslations, type Lang } from '../i18n/utils';
import { profile } from '../data/profile';
import ButtonLink from './ButtonLink.astro';
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const home = languages[lang].home;

// Section ids are shared by both languages (code in English).
const sections = [
  { id: 'about', label: t('nav.about') },
  { id: 'experience', label: t('nav.experience') },
  { id: 'projects', label: t('nav.projects') },
  { id: 'skills', label: t('nav.skills') },
  { id: 'education', label: t('nav.education') },
  { id: 'contact', label: t('nav.contact') },
];
---

<header class="sticky top-0 z-50 border-b border-border bg-bg/85 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-3 px-4 sm:px-6">
    <a
      href={home}
      aria-label={t('header.home')}
      class="shrink-0 font-semibold tracking-tight focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
    >
      <span class="font-mono text-primary" aria-hidden="true">~/</span>Luis Otávio<span class="hidden sm:inline"> Batista</span>
    </a>

    <nav aria-label={t('nav.label')} class="hidden lg:block">
      <ul class="flex items-center gap-6 text-sm">
        {
          sections.map(({ id, label }) => (
            <li>
              <a
                href={`${home}#${id}`}
                class="text-muted transition-colors hover:text-text focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-1 sm:gap-2">
      <LanguageSwitcher label={t('lang.label')} />
      <ThemeToggle label={t('theme.toggle')} />
      <ButtonLink href={profile.cv[lang]} download={profile.cvDownloadName} size="sm" class="ml-1">
        <Icon name="download" class="hidden size-4 sm:block" />
        {t('cv.label')}
      </ButtonLink>
    </div>
  </div>
</header>
