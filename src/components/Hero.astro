---
import { Image } from 'astro:assets';
import photo from '../img/foto-hero.jpg';
import { profile } from '../data/profile';
import { languages, useTranslations, type Lang } from '../i18n/utils';
import ButtonLink from './ButtonLink.astro';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section aria-labelledby="hero-title" class="relative isolate overflow-hidden">
  <!-- Decoration: dot grid + two soft glows (indigo and amber), faded out before the bottom edge. -->
  <div
    class="absolute inset-0 -z-10 [mask-image:linear-gradient(to_bottom,#000_55%,transparent_95%)]"
    aria-hidden="true"
  >
    <div class="bg-dots absolute inset-0"></div>
    <div
      class="absolute -top-32 -right-24 size-[26rem] rounded-full bg-primary/20 blur-3xl sm:size-[34rem]"
    ></div>
    <div class="absolute top-1/2 -left-40 size-[22rem] rounded-full bg-accent/10 blur-3xl"></div>
  </div>

  <div
    class="mx-auto grid min-h-[calc(76svh-4rem)] max-w-5xl items-center gap-12 px-4 py-10 sm:px-6 sm:py-16 md:grid-cols-[1fr_auto] lg:gap-16"
  >
    <div>
      <p class="fade-up font-mono text-sm text-primary">{t('hero.role')}</p>

      <h1
        id="hero-title"
        class="fade-up mt-3 text-4xl font-bold tracking-tight text-balance sm:text-6xl"
        style="--delay: 60ms"
      >
        {profile.name}
      </h1>

      <p class="fade-up mt-4 max-w-3xl text-lg font-medium text-pretty sm:text-xl" style="--delay: 120ms">
        {t('hero.headline')}{' '}
        <span class="whitespace-nowrap text-accent">{t('hero.headlineHighlight')}</span>
      </p>

      <p
        class="fade-up mt-4 max-w-2xl text-base leading-relaxed text-muted sm:mt-6 sm:text-lg"
        style="--delay: 180ms"
      >
        {t('hero.valueProp')}
      </p>

      <div class="fade-up mt-8 flex flex-wrap gap-3 sm:mt-10" style="--delay: 240ms">
        <ButtonLink href={profile.cv[lang]} download={profile.cvDownloadName[lang]}>
          <Icon name="download" />
          {t('cv.label')}
        </ButtonLink>
        <ButtonLink href={`${languages[lang].home}#contact`} variant="secondary">
          <Icon name="mail" />
          {t('hero.contact')}
        </ButtonLink>
        <ButtonLink href={profile.github} variant="ghost" external>
          <Icon name="github" />
          {t('hero.github')}
          <span class="sr-only">{t('hero.newTab')}</span>
        </ButtonLink>
      </div>
    </div>

    <!-- Photo: below the buttons on mobile (keeps CTAs in the first fold), right column from md. -->
    <div class="fade-up relative w-60 justify-self-center sm:w-72 md:w-64 lg:w-80" style="--delay: 150ms">
      <div
        class="absolute inset-0 translate-x-3 translate-y-3 rounded-2xl bg-linear-to-br from-primary to-accent opacity-70 sm:translate-x-4 sm:translate-y-4"
        aria-hidden="true"
      ></div>
      <Image
        src={photo}
        alt={t('hero.photoAlt')}
        widths={[240, 320, 480, 640]}
        sizes="(min-width: 1024px) 320px, (min-width: 768px) 256px, (min-width: 640px) 288px, 240px"
        priority
        class="relative aspect-[25/32] w-full rounded-2xl border border-border object-cover"
      />
    </div>
  </div>
</section>
