---
import { profile } from '../data/profile';
import { languages, useTranslations, type Lang } from '../i18n/utils';
import ButtonLink from './ButtonLink.astro';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  aria-labelledby="hero-title"
  class="mx-auto flex min-h-[calc(100svh-4rem)] max-w-5xl flex-col justify-center px-4 py-10 sm:px-6 sm:py-16"
>
  <p class="font-mono text-sm text-primary">{t('hero.role')}</p>

  <h1 id="hero-title" class="mt-3 text-4xl font-bold tracking-tight text-balance sm:text-6xl">
    {profile.name}
  </h1>

  <p class="mt-4 max-w-3xl text-lg font-medium text-balance sm:text-xl">
    {t('hero.headline')}
    <span class="text-accent">{t('hero.headlineHighlight')}</span>
  </p>

  <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted sm:mt-6 sm:text-lg">
    {t('hero.valueProp')}
  </p>

  <div class="mt-8 flex flex-wrap gap-3 sm:mt-10">
    <ButtonLink href={profile.cv[lang]} download={profile.cvDownloadName}>
      <Icon name="download" />
      {t('cv.label')}
    </ButtonLink>
    <ButtonLink href={`${languages[lang].home}#contact`} variant="secondary">
      <Icon name="mail" />
      {t('hero.contact')}
    </ButtonLink>
    <ButtonLink href={profile.github} variant="ghost" external>
      <Icon name="github" />
      {t('hero.github')}
      <span class="sr-only">{t('hero.newTab')}</span>
    </ButtonLink>
  </div>
</section>
