---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
const headingId = `${id}-title`;
---

<section id={id} aria-labelledby={headingId} class="mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-24">
  <h2 id={headingId} class="flex items-center gap-3 text-2xl font-bold tracking-tight sm:text-3xl">
    <span class="font-mono text-base font-medium text-primary" aria-hidden="true">#</span>
    {title}
  </h2>
  <div class="mt-8 sm:mt-10">
    <slot />
  </div>
</section>
