---
interface Props {
  id: string;
  title: string;
  /** Full-width tinted band, used to alternate the rhythm between sections. */
  band?: boolean;
}

const { id, title, band = false } = Astro.props;
const headingId = `${id}-title`;
---

<section
  id={id}
  aria-labelledby={headingId}
  class:list={['relative', band && 'border-y border-border bg-surface/60']}
>
  <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6 sm:py-20">
    <h2 id={headingId} class="flex items-center gap-3 text-2xl font-bold tracking-tight sm:text-3xl">
      <span class="font-mono text-base font-medium text-primary" aria-hidden="true">#</span>
      {title}
      <span
        class="ml-2 h-px flex-1 bg-linear-to-r from-primary/60 via-accent/30 to-transparent"
        aria-hidden="true"
      ></span>
    </h2>
    <div class="mt-8 sm:mt-10">
      <slot />
    </div>
  </div>
</section>
