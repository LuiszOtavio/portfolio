---
import BaseLayout from '../layouts/BaseLayout.astro';
import ButtonLink from '../components/ButtonLink.astro';
import { languages, useTranslations } from '../i18n/utils';

// A single 404 for both languages: Portuguese first, English below.
const pt = useTranslations('pt');
const en = useTranslations('en');
---

<BaseLayout
  lang="pt"
  title={pt('notFound.title')}
  description={pt('notFound.body')}
  alternates={{ pt: languages.pt.home, en: languages.en.home }}
>
  <main class="mx-auto flex min-h-[70svh] max-w-3xl flex-col justify-center px-4 py-16 sm:px-6">
    <p class="font-mono text-sm text-primary">404</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">{pt('notFound.title')}</h1>
    <p class="mt-4 text-lg text-muted">{pt('notFound.body')}</p>
    <p class="mt-2 text-muted" lang="en">{en('notFound.body')}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <ButtonLink href={languages.pt.home}>{pt('notFound.home')}</ButtonLink>
      <ButtonLink href={languages.en.home} variant="secondary" lang="en">{en('notFound.home')}</ButtonLink>
    </div>
  </main>
</BaseLayout>
