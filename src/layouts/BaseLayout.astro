---
import '../styles/global.css';
import Header from '../components/Header.astro';
import { languages, type Lang } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** Equivalent page in each language, when its path is not just the /en prefix. */
  alternates?: Partial<Record<Lang, string>>;
}

const { title, description, lang, alternates } = Astro.props;
---

<!doctype html>
<html lang={languages[lang].htmlLang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Apply the saved theme before first paint to avoid a flash of the wrong theme. -->
    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'light') {
          document.documentElement.dataset.theme = 'light';
        }
      } catch {}
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body class="min-h-screen">
    <Header lang={lang} alternates={alternates} />
    <slot />
  </body>
</html>
